PORT=3001
CORS_ORIGIN=http://localhost:5173

# Database (Turso / SQLite via LibSQL & Prisma)
# Option 1: URL with embedded auth token
# DATABASE_URL=libsql://your-database-name.turso.io?authToken=your_turso_jwt_token_here
# Option 2: Clean URL + separate auth token
DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_jwt_token_here

# Blockchain (Stellar Mainnet / Soroban)
GAME_SIGNING_KEY=your_private_key_here
CONTRACT_ADDRESS=your_deployed_contract_address_here
RPC_URL=https://mainnet.sorobanrpc.com
